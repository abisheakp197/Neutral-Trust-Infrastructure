SOVEREIGN_MODE=true
SOVEREIGN_ORG=YOUR_ORGANIZATION_NAME
SOVEREIGN_COUNTRY=YOUR_COUNTRY_CODE

UBE_PORT=3000
NODE_ENV=production

ADMIN_SECRET=CHANGE_THIS_TO_STRONG_SECRET_MIN_32_CHARS
MASTER_KEY=CHANGE_THIS_TO_STRONG_MASTER_KEY_MIN_32_CHARS
JWT_SECRET=CHANGE_THIS_TO_STRONG_JWT_SECRET_MIN_32_CHARS
UBE_PASSWORD_SALT=CHANGE_THIS_TO_STRONG_SALT_MIN_32_CHARS

TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-token

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

UBE_MAX_FILE_MB=100
UBE_LARGE_FILE_MB=50
UBE_MAX_VERSIONS=10
UBE_RETENTION_DAYS=90
UBE_CHUNK_SIZE=5
UBE_MAX_EXTRACT_MB=10

GATEKEEPER_DEFAULT_COUNTRY=YOUR_COUNTRY_CODE
GATEKEEPER_STRICT_MODE=true
GATEKEEPER_AUTO_FREEZE_THRESHOLD=80
GATEKEEPER_CONFLICT_STRATEGY=MOST_RESTRICTIVE

HEALTH_INTERVAL_MS=30000
LOG_LEVEL=warn

CYBER_BLOCK_THRESHOLD=75
CYBER_BLOCK_DURATION_MS=3600000
FINANCE_EXCHANGE_CACHE_MS=60000
FINANCE_CRYPTO_CACHE_MS=30000
FINANCE_LARGE_CONVERSION=10000
AI_COST_ALERT_THRESHOLD=10.00
